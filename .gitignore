# macOS
.DS_Store
**/.DS_Store

# iCloud placeholder stubs
*.icloud

# Secrets — never commit API keys / tokens
.env
.env.*
*.token
*.key
*.pem
secrets.*
**/credentials*

# Local build / editor cruft
*.log
node_modules/
__pycache__/
*.pyc

# Per-machine Claude Code settings (settings.json is shared; .local.json is personal —
# it was committed once and carried another machine's absolute paths)
.claude/settings.local.json

# Local working backup
*.glenbak
